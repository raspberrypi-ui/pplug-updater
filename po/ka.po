#: src/updater.c:60
msgid "Hours between checks for updates"
msgstr "საათების განახლების შემოწმებებს შორის"

#: src/updater.c:198
msgid ""
"Updates are available\n"
"Click the update icon to install"
msgstr ""
"განახლებები ხელმისაწვდომია\n"
"დასაყენებლად დააწკაპუნეთ ხატულაზე 'განახლება'"

#: src/updater.c:315
msgid "Show Updates..."
msgstr "განახლებების ჩვენება..."

#: src/updater.c:320
msgid "Install Updates"
msgstr "განახლებების დაყენება"

#: src/updater.c:452
msgid "Updates are available - click to install"
msgstr "განახლებები ხელმისაწვდომია - დასაყენებლად დააწკაპუნეთ"

#: src/updater.c:565
msgid "Checks for updates"
msgstr "შეამოწმებს განახლებების არსებობას"

